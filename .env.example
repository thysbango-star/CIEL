# Ciel never reads API keys from files or environment variables at runtime:
# keys are entered in the app (Settings → AI Providers) and encrypted with the Android Keystore.
# These variables are only for CI release signing (set them as GitHub repository secrets):
CIEL_KEYSTORE_BASE64=   # base64 of your .jks file
CIEL_KEYSTORE_PASSWORD=
CIEL_KEY_ALIAS=
CIEL_KEY_PASSWORD=
